# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Bybit API credentials — TRADE PERMISSION ONLY. Never enable withdrawals.
# Testnet keys: https://testnet.bybit.com  (Account -> API Management)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# "testnet" or "live". Must be "testnet" until explicitly approved otherwise.
BYBIT_ENV=testnet

# Optional: comma-separated IPs this key is whitelisted for (informational,
# enforced on the exchange side — document it here so it's not forgotten).
BYBIT_IP_WHITELIST=

# Telegram alerting (Guardian B, later milestone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
